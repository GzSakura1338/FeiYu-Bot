{
  "id": "welcome",
  "name": "进群欢迎",
  "version": "1.0.0",
  "author": "FeiYu Bot",
  "description": "有人进群时发一句欢迎，有人撤回消息时（可选）吐槽一句",
  "host": ">=0.2.0",
  "run": { "command": "python", "args": ["main.py"] },
  "permissions": ["qq.reply"],
  "events": ["notice.join", "notice.recall"],
  "settings": {
    "type": "object",
    "properties": {
      "welcome": { "type": "string", "title": "欢迎语（{qq} 会换成新人的 QQ 号）", "default": "欢迎新朋友 {qq} 进群～先看看群公告哦", "maxLength": 200 },
      "recall_joke": { "type": "boolean", "title": "有人撤回时吐槽一句", "default": false }
    }
  }
}
