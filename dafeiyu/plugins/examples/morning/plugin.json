{
  "id": "morning",
  "name": "早报",
  "version": "1.0.0",
  "author": "FeiYu Bot",
  "description": "每天早上 8 点往指定的群发一条早安：日期、星期、离周末还有几天，再加一句你写的话",
  "host": ">=0.2.0",
  "run": { "command": "python", "args": ["main.py"] },
  "permissions": ["qq.send"],
  "schedules": [
    { "id": "morning", "cron": "0 8 * * *", "description": "每天 8:00 发早安" }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "group_ids": { "type": "array", "title": "发到哪些群（群号）", "items": { "type": "string" }, "default": [] },
      "greeting": { "type": "string", "title": "附加的一句话", "default": "早上好呀，今天也要开开心心的～", "maxLength": 200 }
    }
  }
}
