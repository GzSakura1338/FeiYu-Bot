{
  "id": "rss",
  "name": "RSS 订阅推送",
  "version": "1.0.0",
  "author": "FeiYu Bot",
  "description": "每 30 分钟检查一次订阅的 RSS / Atom，有新文章就推送到指定的群（每次每个订阅最多 3 条）",
  "host": ">=0.2.0",
  "run": { "command": "python", "args": ["main.py"] },
  "permissions": ["qq.send", "qq.reply", "network"],
  "schedules": [
    { "id": "check", "cron": "*/30 * * * *", "description": "每 30 分钟检查一次" }
  ],
  "commands": [
    { "name": "rss", "description": "立刻检查一次订阅", "scope": ["group", "private"] }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "feeds": { "type": "array", "title": "订阅地址（RSS 或 Atom）", "items": { "type": "string" }, "default": [] },
      "group_ids": { "type": "array", "title": "推送到哪些群（群号）", "items": { "type": "string" }, "default": [] }
    }
  }
}
