{
  "id": "nodeecho",
  "name": "Node 回声",
  "version": "1.0.0",
  "author": "test",
  "description": "测试用：Node SDK 写的回声插件",
  "host": ">=0.2.0",
  "run": { "command": "node", "args": ["main.js"] },
  "permissions": ["qq.reply"],
  "commands": [
    { "name": "necho", "aliases": ["ne"], "description": "原样回复" },
    { "name": "npass", "description": "返回 handled=false" }
  ],
  "events": ["message.group"],
  "tools": [
    { "name": "echo", "description": "原样返回 text", "parameters": { "type": "object", "properties": { "text": { "type": "string" } }, "required": ["text"] } }
  ]
}
