{
  "id": "p2a",
  "name": "P2 主测试",
  "version": "1.0.0",
  "author": "test",
  "description": "测试用：拦截、出站过滤、定时任务、事件记录、发消息和读记录",
  "host": ">=0.2.0",
  "run": { "command": "python", "args": ["main.py"] },
  "permissions": ["qq.reply", "qq.send", "qq.read", "qq.filter"],
  "events": ["message.group", "notice.join", "notice.leave", "notice.recall", "notice.poke", "bot.said", "bot.connected", "bot.disconnected"],
  "intercept": true,
  "filter": true,
  "priority": 10,
  "schedules": [{ "id": "tick", "cron": "* * * * *", "description": "每分钟" }],
  "tools": [
    { "name": "send", "description": "发群消息", "parameters": { "type": "object", "properties": { "group": { "type": "string" }, "text": { "type": "string" } }, "required": ["group", "text"] } },
    { "name": "history", "description": "读记录", "parameters": { "type": "object", "properties": { "group": { "type": "string" }, "user": { "type": "string" } } } },
    { "name": "members", "description": "读群成员", "parameters": { "type": "object", "properties": { "group": { "type": "string" } }, "required": ["group"] } }
  ]
}
