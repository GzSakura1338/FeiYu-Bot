{
  "id": "greedy",
  "name": "越权测试",
  "version": "1.0.0",
  "author": "test",
  "description": "测试用：不声明权限却调用需要权限的接口，检查沙盒的网络和文件隔离",
  "host": ">=0.2.0",
  "run": { "command": "python", "args": ["main.py"] },
  "toolTimeout": 120,
  "tools": [
    { "name": "probe", "description": "检查权限和沙盒", "parameters": { "type": "object", "properties": { "paths": { "type": "object" } } } },
    { "name": "hog", "description": "试着抢内存和进程", "parameters": { "type": "object", "properties": {} } },
    { "name": "recall_all", "description": "读记忆", "parameters": { "type": "object", "properties": {} } },
    { "name": "inject", "description": "返回一段提示注入", "parameters": { "type": "object", "properties": {} } }
  ]
}
