{
  "id": "echo",
  "name": "回声",
  "version": "1.0.0",
  "author": "test",
  "description": "测试用：命令原样回复、工具返回参数、记录收到的事件、提供提示词补充",
  "host": ">=0.2.0",
  "run": { "command": "python", "args": ["main.py"] },
  "permissions": ["qq.reply"],
  "commands": [
    { "name": "echo", "aliases": ["e"], "description": "原样回复", "scope": ["group", "private"] },
    { "name": "groupecho", "description": "只在群里生效", "scope": ["group"] },
    { "name": "pass", "description": "返回 handled=false" }
  ],
  "events": ["message.group", "message.private", "bot.said", "notice.join"],
  "prompt": true,
  "tools": [
    { "name": "echo", "description": "原样返回 text", "parameters": { "type": "object", "properties": { "text": { "type": "string" } }, "required": ["text"] }, "mind": true },
    { "name": "add", "description": "两数相加", "parameters": { "type": "object", "properties": { "a": { "type": "integer" }, "b": { "type": "integer" } }, "required": ["a", "b"] } },
    { "name": "big", "description": "返回 1 MB 文本", "parameters": { "type": "object", "properties": {} } }
  ],
  "settings": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": { "type": "string", "title": "名字", "default": "回声", "maxLength": 10 },
      "count": { "type": "integer", "title": "次数", "default": 1, "minimum": 1, "maximum": 5 },
      "loud": { "type": "boolean", "title": "大声", "default": false },
      "mode": { "type": "string", "title": "模式", "enum": ["a", "b"], "default": "a" },
      "tags": { "type": "array", "title": "标签", "items": { "type": "string" }, "default": [] },
      "token": { "type": "string", "title": "密钥", "secret": true }
    }
  }
}
